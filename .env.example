# StateBoard 本地环境变量示例
# 用法：复制本文件为 .env（cp .env.example .env），按需修改。
# .env 已写入 .gitignore，不会提交到仓库。
# 加载机制：application.yml 通过 spring.config.import: optional:file:.env[.properties]
# 导入本文件（properties 格式，KEY=VALUE）；未配置的项使用 application.yml 中的
# localhost 默认值。

# PostgreSQL 连接
ASC_DB_URL=jdbc:postgresql://localhost:5432/asc
ASC_DB_USERNAME=asc
ASC_DB_PASSWORD=asc

# Redis 连接
ASC_REDIS_HOST=localhost
ASC_REDIS_PORT=6379
