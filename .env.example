# StateBoard 本地环境变量示例
# 用法：复制本文件为 .env（cp .env.example .env），按需修改。
# .env 已写入 .gitignore，不会提交到仓库。
# 加载机制：application.yml 通过 spring.config.import: optional:file:.env[.properties]
# 导入本文件（properties 格式，KEY=VALUE）；未配置的项使用 application.yml 中的
# localhost 默认值。

# PostgreSQL 连接
ASC_DB_URL=jdbc:postgresql://localhost:5432/asc
ASC_DB_USERNAME=asc
ASC_DB_PASSWORD=asc

# Redis 连接
ASC_REDIS_HOST=localhost
ASC_REDIS_PORT=6379

# v0.7 真实 LLM 评测（benchmarks/runner.py --agent llm）
# provider 注册表见 benchmarks/providers.json；切换服务商只改 ASC_BENCH_PROVIDER。
# 所有密钥只放在本文件，不入库。

# 默认 DeepSeek
ASC_BENCH_PROVIDER=deepseek
ASC_BENCH_LLM_API_KEY=

# Ollama（本地，无需密钥；先执行 ollama pull qwen2.5:7b）
# ASC_BENCH_PROVIDER=ollama
# ASC_BENCH_OLLAMA_BASE_URL=http://localhost:11434/v1
# ASC_BENCH_OLLAMA_MODEL=qwen2.5:7b

# OpenAI
# ASC_BENCH_PROVIDER=openai
# ASC_BENCH_OPENAI_API_KEY=
# ASC_BENCH_OPENAI_MODEL=gpt-4o-mini

# 通义千问（百炼 OpenAI 兼容模式）
# ASC_BENCH_PROVIDER=qwen
# ASC_BENCH_QWEN_API_KEY=
# ASC_BENCH_QWEN_MODEL=qwen-plus

# 任意自建 / 第三方 OpenAI 兼容端点
# ASC_BENCH_PROVIDER=custom
# ASC_BENCH_LLM_BASE_URL=http://localhost:8000/v1
# ASC_BENCH_LLM_API_KEY=
# ASC_BENCH_MODEL=my-model
# 若完整路径不是 <base>/v1/chat/completions，可直接指定：
# ASC_BENCH_CHAT_URL=http://localhost:8000/custom/chat/completions
